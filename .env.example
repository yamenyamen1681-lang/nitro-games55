# ============================================================
#  انسخ هذا الملف وسمّه .env ثم عبّئ القيم
#  (ملف .env.example آمن للرفع على GitHub — لا يحتوي أسرار)
# ============================================================

# 1️⃣ قاعدة البيانات PostgreSQL
#    احصل عليها مجاناً من: https://neon.tech
#    أو من Vercel → Storage → Create Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 2️⃣ رابط موقعك (مهم جداً للـ SEO)
#    على Vercel: انسخ الرابط من لوحة التحكم
#    مثال: https://nitro-games-xyz.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
